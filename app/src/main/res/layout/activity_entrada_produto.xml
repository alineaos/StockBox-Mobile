<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".EntradaProdutoActivity">

        <ScrollView
            android:layout_width="373dp"
            android:layout_height="678dp"
            android:layout_marginStart="15dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="23dp"
            android:layout_marginBottom="45dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="373dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:src="@drawable/logostockbox"
                    android:layout_marginBottom="20dp"/>

                <TextView
                    android:id="@+id/tvExplicacao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Importe sua Nota Fiscal \nou preencha os campos manualmente"
                    android:textStyle="normal"
                    android:textAlignment="center"
                    android:textSize="16dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="10dp"
                    style="@style/tv_entrada_produto"/>

                <Button
                    android:id="@+id/btImportarNotaFiscal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Importar Nota Fiscal"
                    android:textSize="15dp"

                    style="@style/botao"
                    app:cornerRadius="10dp"
                    />

                <TextView
                    android:id="@+id/tvNotaFiscal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Número da Nota Fiscal"
                    style="@style/tv_entrada_produto"/>

                <EditText
                    android:id="@+id/etNotaFiscal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:text=""
                    android:textColor="@color/cinza_escuro"
                    android:inputType="number"
                    android:background="@android:drawable/editbox_background" />

                <TextView
                    android:id="@+id/tvFornecedor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Fornecedor"
                    style="@style/tv_entrada_produto"/>

                <EditText
                    android:id="@+id/etFornecedor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:text=""
                    android:textColor="@color/cinza_escuro"
                    android:background="@android:drawable/editbox_background"/>

                <TextView
                    android:id="@+id/tvQuantidade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Quantidade"
                    style="@style/tv_entrada_produto"/>

                <EditText
                    android:id="@+id/etQuantidade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="numberDecimal"
                    android:text=""
                    android:textColor="@color/cinza_escuro"
                    android:background="@android:drawable/editbox_background"/>

                <TextView
                    android:id="@+id/tvValorUnitario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Valor Unitário"
                    style="@style/tv_entrada_produto"/>

                <EditText

                    android:id="@+id/etValorUnitario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="numberDecimal"
                    android:text=""
                    android:textColor="@color/cinza_escuro"
                    android:background="@android:drawable/editbox_background"/>

                <Button
                    android:id="@+id/btSalvarRegistro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Salvar Registro"
                    android:textSize="15dp"
                    style="@style/botao"
                    android:layout_marginTop="10dp"
                    app:cornerRadius="10dp"
                    />
                <Button
                    android:id="@+id/btVoltar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Voltar"
                    android:textSize="15dp"
                    style="@style/botao"
                    app:cornerRadius="10dp"
                    />
            </LinearLayout>
        </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>