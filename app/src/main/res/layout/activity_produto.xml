<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ProdutoActivity">

    <LinearLayout
        android:layout_width="373dp"
        android:layout_height="678dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="23dp"
        android:layout_marginBottom="45dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:src="@drawable/logostockbox"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <Button
                android:id="@+id/btCadastrar"
                style="@style/botao"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="CADASTRAR PRODUTO"
                app:cornerRadius="10dp" />

            <Button
                android:id="@+id/btEntrada"
                style="@style/botao"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="REGISTRAR ENTRADA"
                app:cornerRadius="10dp" />

            <Button
                android:id="@+id/btSaida"
                style="@style/botao"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="REGISTRAR SAÍDA"
                app:cornerRadius="10dp" />

            <Button
                android:id="@+id/btContagem"
                style="@style/botao"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="CONTAGEM"
                app:cornerRadius="10dp" />

            <Button
                android:id="@+id/btVoltar"
                style="@style/botao"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="VOLTAR"
                app:cornerRadius="10dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>